@@ -114,6 +114,53 @@ private:
 
   static uint64_t ExitFunctionLink(FEXCore::Core::CpuStateFrame* Frame, FEXCore::Context::ExitFunctionLinkData* Record);
 
+  // Unaligned atomic fallback (CPUBackend::UnalignedAtomicFallback).
+  // An LSE atomic only faults when its access crosses a 16-byte boundary (FEAT_LSE2), so the check below sends only
+  // those accesses to the slow copy of the op. The slow copy is the same instruction sequence, with the atomic
+  // instruction replaced by a call to the dispatcher's UnalignedAtomicStub, which emulates that exact instruction word
+  // with the SIGBUS handler's code. Aligned accesses run the unchanged fast copy.
+  bool InUnalignedAtomicSlowPath {};
+
+  // Only for the LSE (HostFeatures.SupportsAtomics) code paths: LL/SC sequences are handled differently by the SIGBUS handler.
+  template<typename F>
+  void EmitWithUnalignedAtomicFallback(ARMEmitter::Register Addr, uint32_t AccessBytes, F&& Body) {
+    if (!UnalignedAtomicFallback || AccessBytes <= 1) {
+      Body();
+      return;
+    }
+
+    ARMEmitter::ForwardLabel SlowPath;
+    ARMEmitter::ForwardLabel Done;
+
+    // Flag-free: crosses 16 bytes iff ((Addr & 15) + AccessBytes - 1) >= 16. TMP1 is free at the start of every atomic op.
+    and_(ARMEmitter::Size::i64Bit, TMP1, Addr, 0xF);
+    add(ARMEmitter::Size::i64Bit, TMP1, TMP1, AccessBytes - 1);
+    (void)tbnz(TMP1, 4, &SlowPath);
+    Body();
+    (void)b(&Done);
+
+    (void)Bind(&SlowPath);
+    InUnalignedAtomicSlowPath = true;
+    Body();
+    InUnalignedAtomicSlowPath = false;
+    (void)Bind(&Done);
+  }
+
+  template<typename F>
+  void EmitAtomicInst(F&& Inst) {
+    if (!InUnalignedAtomicSlowPath) {
+      Inst();
+      return;
+    }
+
+    str<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, -16);
+    ldr(ARMEmitter::XReg::lr, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.UnalignedAtomicStub));
+    blr(ARMEmitter::Reg::r30);
+    // Data for the stub: the stub decodes this instruction word, emulates it and returns past it.
+    Inst();
+    ldr<ARMEmitter::IndexType::POST>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, 16);
+  }
