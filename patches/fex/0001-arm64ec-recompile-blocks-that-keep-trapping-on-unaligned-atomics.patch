@@ -1158,6 +1170,23 @@ void ContextImpl::MarkMonoBackpatcherBlock(uint64_t BlockEntry) {
   MonoBackpatcherBlock.store(BlockEntry, std::memory_order_relaxed);
 }
 
+void ContextImpl::MarkUnalignedAtomicBlock(uint64_t BlockEntry) {
+  LogMan::Throw::AFmt(CodeInvalidationMutex.try_lock() == false, "CodeInvalidationMutex needs to be unique_locked here");
+  UnalignedAtomicBlocks.insert(BlockEntry);
+  HasUnalignedAtomicBlocks.store(true, std::memory_order_relaxed);
+}
+
+void ContextImpl::UnalignedAtomicFallback(uint64_t* GPRs, uint64_t InstructionAddress, FEXCore::Core::CpuStateFrame* Frame) {
+  // The word at InstructionAddress is the atomic instruction that the JIT would otherwise have executed (and trapped on).
+  // Emulate it with exactly the code the SIGBUS handler runs for it, including the StrictInProcessSplitLocks mutex.
+  // IsJIT = false selects the decode-and-emulate path, which never backpatches.
+  const auto Result = FEXCore::ArchHelpers::Arm64::HandleUnalignedAccess(
+    Frame->Thread, FEXCore::ArchHelpers::Arm64::UnalignedHandlerType::NonAtomic, InstructionAddress, GPRs, false);
+  if (!Result.has_value()) [[unlikely]] {
+    ERROR_AND_DIE_FMT("Unaligned atomic fallback: unhandled instruction 0x{:08x}", *reinterpret_cast<const uint32_t*>(InstructionAddress));
+  }
+}
