diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
index 5637b8cef..d7dd1278a 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -607,6 +607,101 @@ void Dispatcher::EmitDispatcher() {
     (void)b(&LoopTop);
   }
 
+  {
+    // Unaligned atomic fallback stub, used by blocks compiled with CPUBackend::UnalignedAtomicFallback.
+    //
+    // JIT call site (see Arm64JITCore::EmitAtomicInst):
+    //   str x30, [sp, #-16]!
+    //   ldr x30, [STATE, Pointers.UnalignedAtomicStub]
+    //   blr x30
+    //   <atomic instruction word, never executed>
+    //   ldr x30, [sp], #16
+    //
+    // On entry x30 points at the atomic instruction word and [sp] holds the call site's x30.
+    // Every GPR, NZCV and every vector register is preserved, except for the registers the emulated instruction writes,
+    // which are updated in the saved GPR array by ContextImpl::UnalignedAtomicFallback.
+    UnalignedAtomicStubAddress = GetCursorAddress<uint64_t>();
+
+    // GPR array layout, indexed like a host context: [0..30] = x0-x30, [31] = sp, [32] = NZCV, [33] = instruction address.
+    constexpr uint32_t GPRFrameSize = 34 * 8; // 272, keeps sp 16-byte aligned.
+    constexpr uint32_t SlotSP = 31 * 8;
+    constexpr uint32_t SlotNZCV = 32 * 8;
+    constexpr uint32_t SlotInst = 33 * 8;
+    const bool SVE256Regs = EmitterCTX->HostFeatures.SupportsSVE256;
+    const uint32_t VectorFrameSize = 32 * (SVE256Regs ? 32 : 16);
+
+    static constexpr std::array<ARMEmitter::VRegister, 32> AllVectorRegisters {
+      ARMEmitter::VReg::v0,  ARMEmitter::VReg::v1,  ARMEmitter::VReg::v2,  ARMEmitter::VReg::v3,  ARMEmitter::VReg::v4,
+      ARMEmitter::VReg::v5,  ARMEmitter::VReg::v6,  ARMEmitter::VReg::v7,  ARMEmitter::VReg::v8,  ARMEmitter::VReg::v9,
+      ARMEmitter::VReg::v10, ARMEmitter::VReg::v11, ARMEmitter::VReg::v12, ARMEmitter::VReg::v13, ARMEmitter::VReg::v14,
+      ARMEmitter::VReg::v15, ARMEmitter::VReg::v16, ARMEmitter::VReg::v17, ARMEmitter::VReg::v18, ARMEmitter::VReg::v19,
+      ARMEmitter::VReg::v20, ARMEmitter::VReg::v21, ARMEmitter::VReg::v22, ARMEmitter::VReg::v23, ARMEmitter::VReg::v24,
+      ARMEmitter::VReg::v25, ARMEmitter::VReg::v26, ARMEmitter::VReg::v27, ARMEmitter::VReg::v28, ARMEmitter::VReg::v29,
+      ARMEmitter::VReg::v30, ARMEmitter::VReg::v31,
+    };
+
+    sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, GPRFrameSize);
+    for (uint32_t i = 0; i < 30; i += 2) {
+      stp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::XRegister(i), ARMEmitter::XRegister(i + 1), ARMEmitter::Reg::rsp, i * 8);
+    }
+    // x30 as it was at the call site.
+    ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, GPRFrameSize);
+    str(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, 30 * 8);
+    // sp as it was at the call site.
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r0, ARMEmitter::Reg::rsp, GPRFrameSize + 16);
+    str(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SlotSP);
+    mrs(ARMEmitter::XReg::x0, ARMEmitter::SystemRegister::NZCV);
+    str(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SlotNZCV);
+    str(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, SlotInst);
+
+    sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, VectorFrameSize);
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, ARMEmitter::Reg::rsp, 0);
+    PushVectorRegisters(ARMEmitter::Reg::r1, SVE256Regs, AllVectorRegisters);
+
+    // A guest lock-prefixed instruction is a full barrier.
+    dmb(ARMEmitter::BarrierScope::ISH);
+
+#ifdef ARCHITECTURE_arm64ec
+    // Same as MonoBackpatcherWrite: the emulation may take the split-lock mutex, mark this as a callback.
+    ldr(ARMEmitter::XReg::x2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+    LoadConstant(ARMEmitter::Size::i32Bit, ARMEmitter::Reg::r3, 1);
+    strb(ARMEmitter::WReg::w3, ARMEmitter::Reg::r2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
+#endif
+
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r0, ARMEmitter::Reg::rsp, VectorFrameSize);
+    ldr(ARMEmitter::XReg::x1, ARMEmitter::Reg::r0, SlotInst);
+    mov(ARMEmitter::XReg::x2, STATE);
+    ldr(ARMEmitter::XReg::x3, STATE_PTR(CpuStateFrame, Pointers.UnalignedAtomicFallback));
+    if (!CTX->Config.DisableVixlIndirectCalls) [[unlikely]] {
+      GenerateIndirectRuntimeCall<void, uint64_t*, uint64_t, void*>(ARMEmitter::Reg::r3);
+    } else {
+      blr(ARMEmitter::Reg::r3);
+    }
+
+#ifdef ARCHITECTURE_arm64ec
+    ldr(ARMEmitter::XReg::x2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+    strb(ARMEmitter::WReg::zr, ARMEmitter::Reg::r2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
+#endif
+
+    dmb(ARMEmitter::BarrierScope::ISH);
+
+    PopVectorRegisters(SVE256Regs, AllVectorRegisters);
+
+    ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SlotNZCV);
+    msr(ARMEmitter::SystemRegister::NZCV, ARMEmitter::XReg::x0);
+    // x30 (possibly written by the emulated instruction) goes back to the call site's slot, which the call site reloads.
+    ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, 30 * 8);
+    str(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, GPRFrameSize);
+    // Return past the instruction word.
+    ldr(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, SlotInst);
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r30, ARMEmitter::Reg::r30, 4);
+    for (uint32_t i = 0; i < 30; i += 2) {
+      ldp<ARMEmitter::IndexType::OFFSET>(ARMEmitter::XRegister(i), ARMEmitter::XRegister(i + 1), ARMEmitter::Reg::rsp, i * 8);
+    }
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, GPRFrameSize);
+    ret();
+  }
+
   EmitF64Sin();
   EmitF64Cos();
   EmitF64Tan();
