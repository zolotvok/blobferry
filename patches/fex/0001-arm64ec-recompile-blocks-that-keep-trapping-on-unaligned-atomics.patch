+namespace UnalignedAtomic {
+// Atomic RMW instructions (CASAL, CASPAL, LD<op>AL, SWPAL) are emulated on every trap and never backpatched. Each trap is a
+// full exception round trip (a ptrace stop under proot). After this many such traps in one JIT block, the block is
+// recompiled with the out-of-line fallback (ContextImpl::MarkUnalignedAtomicBlock), which emulates the same instruction
+// with the same code but without the exception.
+constexpr uint32_t RecompileThreshold = 16;
+// FEX_UNALIGNED_ATOMIC_FALLBACK=0 turns the recompile off (stock behaviour). FEX_UNALIGNED_ATOMIC_STATS=1 prints a
+// short count line via __wine_dbg_output at every power of two of traps and of recompiled blocks, even with FEX_SILENTLOG.
+bool Enabled = true;
+void (*StatsOut)(const char* Message) = nullptr;
+
+std::mutex Mutex;
+fextl::unordered_map<uint64_t, uint32_t> TrapCounts;
+uint64_t TotalTraps {};
+uint64_t MarkedBlocks {};
+
+static void PrintStats(uint64_t Traps, uint64_t Blocks) {
+  if (StatsOut) {
+    const auto Message = fextl::fmt::format("fex-uafb: pid {} rmw_traps {} recompiled_blocks {} enabled {}\n", GetCurrentProcessId(),
+                                            Traps, Blocks, Enabled ? 1 : 0);
+    StatsOut(Message.c_str());
+  }
+}
+
+static void NoteTrap(FEXCore::Core::InternalThreadState* Thread) {
+  const uint64_t BlockEntry = CTX->GetGuestBlockEntry(Thread);
+  uint32_t Count {};
+  uint64_t Traps {};
+  uint64_t Blocks {};
+  {
+    std::scoped_lock Lock(Mutex);
+    Traps = ++TotalTraps;
+    Blocks = MarkedBlocks;
+    if (BlockEntry && Enabled) {
+      Count = ++TrapCounts[BlockEntry];
+      if (Count == RecompileThreshold) {
+        Blocks = ++MarkedBlocks;
+      }
+    }
+  }
+
+  if (std::has_single_bit(Traps)) {
+    PrintStats(Traps, Blocks);
+  }
+
+  if (Count != RecompileThreshold) {
+    return;
+  }
+
+  {
+    // Same locking as the mono backpatcher detection: ThreadCreationMutex for the thread list walked by the
+    // invalidation, then CodeInvalidationMutex uniquely for the mark.
+    std::scoped_lock Lock(ThreadCreationMutex);
+    {
+      std::scoped_lock CodeLock(CTX->GetCodeInvalidationMutex());
+      CTX->MarkUnalignedAtomicBlock(BlockEntry);
+    }
+    // Drops every block on this guest page from the caches. This thread keeps running the old copy of the block until it
+    // leaves it (code memory stays valid, as with SMC invalidation), the next entry compiles the block with the fallback.
+    InvalidationTracker->InvalidateAlignedInterval(BlockEntry, 1, false);
+  }
+
+  LogMan::Msg::DFmt("Unaligned atomic fallback for block {:X} after {} traps", BlockEntry, Count);
+  if (std::has_single_bit(Blocks)) {
+    PrintStats(Traps, Blocks);
+  }
+}
+} // namespace UnalignedAtomic
