-    Hit = DiskCache.Lookup(Thread, Region, GuestRIP, DiskCacheGuestCodeKey);
+    // A cached copy would be the code without the unaligned atomic fallback, so such blocks bypass the disk cache.
+    if (!IsUnalignedAtomicBlock(GuestRIP)) {
+      Hit = DiskCache.Lookup(Thread, Region, GuestRIP, DiskCacheGuestCodeKey);
+    }
     if (Hit && !DiskCache.IsValidating()) {
