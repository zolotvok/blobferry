+bool IsEmulatedAtomicRMW(uint32_t Instr) {
+  if ((Instr & CASPAL_MASK) == CASPAL_INST || (Instr & CASAL_MASK) == CASAL_INST) {
+    return true;
+  }
+
+  // LDAR/LDAPR/STLR partially overlap ATOMIC_MEM_MASK, and are backpatched instead.
+  if ((Instr & LDAXR_MASK) == LDAR_INST || (Instr & LDAXR_MASK) == LDAPR_INST || (Instr & LDAXR_MASK) == STLR_INST) {
+    return false;
+  }
+
+  return (Instr & ATOMIC_MEM_MASK) == ATOMIC_MEM_INST;
+}
