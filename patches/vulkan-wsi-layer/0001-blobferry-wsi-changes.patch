+/* DroidDeck/Mali bridge debug [Claude Opus 5.5] 2026-10-26: MALI_WSI_PROBE_PIXELS=1 logs, for the first presents
+ * and every 300th, the centre pixel and a sampled checksum of the frame being attached (CPU read of the dma-buf after
+ * the GPU is done). Tells a black frame from a frame the compositor does not show. */
+static void probe_pixels(image_backing_memory_external &mem, int fd, const VkExtent3D &extent, uint64_t n)
+{
+   external_memory &ext = mem.get_external_memory();
+   const size_t stride = static_cast<size_t>(ext.get_strides()[0]);
+   const size_t offset = ext.get_offsets()[0];
+   const size_t size = offset + stride * extent.height;
+   if (fd < 0 || stride == 0)
+      return;
+   void *map = mmap(nullptr, size, PROT_READ, MAP_SHARED, fd, 0);
+   if (map == MAP_FAILED)
+   {
+      fprintf(stderr, "mali-wsi: probe: mmap of the frame failed (%d)\n", errno);
+      return;
+   }
+   struct dma_buf_sync sync = { DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ };
+   ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+   const uint8_t *base = static_cast<const uint8_t *>(map) + offset;
+   const uint32_t centre = *reinterpret_cast<const uint32_t *>(base + (extent.height / 2) * stride + (extent.width / 2) * 4);
+   uint64_t sum = 0, nonzero = 0;
+   for (uint32_t y = 0; y < extent.height; y += extent.height / 16 + 1)
+      for (uint32_t x = 0; x < extent.width; x += extent.width / 16 + 1)
+      {
+         uint32_t v = *reinterpret_cast<const uint32_t *>(base + y * stride + x * 4);
+         sum += v & 0x00ffffff;
+         nonzero += (v & 0x00ffffff) != 0;
+      }
+   sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ;
+   ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+   munmap(map, size);
+   fprintf(stderr, "mali-wsi: probe: present %llu %ux%u centre 0x%08x, %llu/289 samples non-black, rgb sum %llu\n",
+           static_cast<unsigned long long>(n), extent.width, extent.height, centre,
+           static_cast<unsigned long long>(nonzero), static_cast<unsigned long long>(sum));
+}
