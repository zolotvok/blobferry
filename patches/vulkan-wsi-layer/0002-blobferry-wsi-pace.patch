index 0000000..f7a1612
--- /dev/null
+++ b/wsi/mali_pace.hpp
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * DroidDeck/Mali bridge [keeper, Claude Opus 5.5] 2026-11-01 (K-WP1, perf-review request (a)): MALI_WSI_PACE=1 logs
+ * the per-frame present pacing, every 5 s, into /root/mali-wsi-pace.txt (MALI_WSI_PACE_FILE overrides the path).
+ * Log only; nothing changes when the variable is unset. It answers where the ~4 ms per frame with no GPU work in
+ * flight come from: the app's present cadence (FIFO quantisation at the display period?), the app blocked in
+ * vkAcquireNextImageKHR (no free image), the page-flip thread waiting for the GPU, or the compositor's frame callback.
+ *
+ * Per 5-s window, for each metric: n, mean, p50, p90, p99, max (ms); for the two intervals also a 1-ms histogram and
+ * the share of intervals within +-1.5 ms of k x the display period (MALI_WSI_PACE_HZ, default 90).
+ *   present_interval  app thread: vkQueuePresentKHR to the next vkQueuePresentKHR (all swapchains of the process)
+ *   commit_interval   page-flip thread: wl_surface_commit to the next one (what the compositor receives)
+ *   acquire_block     app thread: time inside vkAcquireNextImageKHR (waiting for a free image)
+ *   acq_to_present    app thread: acquire returned -> vkQueuePresentKHR of that image (app CPU + submit per frame)
+ *   queue_to_gpu_done vkQueuePresentKHR -> the page-flip thread sees the image's present fence signalled
+ *   flip_gpu_wait     page-flip thread blocked on that present fence
+ *   flip_frame_cb     page-flip thread blocked on the compositor's frame callback (FIFO pacing by the compositor)
+ *   pending_depth     presents queued to the page-flip thread when a new one arrives (frames in flight on our side)
+ * The window formatter is pure (pace_window::format) so the PC unit test (bridge/test/wsi-pace/) checks it.
+ */
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace wsi
+{
+namespace mali_pace
+{
+
+enum metric
+{
+   M_PRESENT_INTERVAL,
+   M_COMMIT_INTERVAL,
+   M_ACQUIRE_BLOCK,
+   M_ACQ_TO_PRESENT,
+   M_QUEUE_TO_GPU_DONE,
+   M_FLIP_GPU_WAIT,
+   M_FLIP_FRAME_CB,
+   M_PENDING_DEPTH, /* a count, stored as "ns" = count * 1e6 so the ms columns read as the count */
+   M_COUNT
+};
+
+static constexpr const char *metric_name[M_COUNT] = { "present_interval", "commit_interval", "acquire_block",
+                                                      "acq_to_present",   "queue_to_gpu_done", "flip_gpu_wait",
+                                                      "flip_frame_cb",    "pending_depth" };
+
+static constexpr int HIST_BINS = 51; /* 1-ms bins 0..49, bin 50 = >= 50 ms */
+static constexpr size_t MAX_SAMPLES = 4096; /* per metric and window; more are counted in n/mean/max only */
+
+struct pace_window
+{
+   std::vector<int64_t> samples[M_COUNT];
+   uint64_t n[M_COUNT] = {};
+   double sum_ns[M_COUNT] = {};
+   int64_t max_ns[M_COUNT] = {};
+   uint32_t hist[2][HIST_BINS] = {}; /* present_interval, commit_interval */
+
+   void add(metric m, int64_t ns)
+   {
+      if (ns < 0)
+         ns = 0;
+      n[m]++;
+      sum_ns[m] += static_cast<double>(ns);
+      max_ns[m] = std::max(max_ns[m], ns);
+      if (samples[m].size() < MAX_SAMPLES)
+         samples[m].push_back(ns);
+      if (m == M_PRESENT_INTERVAL || m == M_COMMIT_INTERVAL)
+      {
+         int64_t b = ns / 1000000;
+         hist[m == M_COMMIT_INTERVAL][b >= HIST_BINS - 1 ? HIST_BINS - 1 : b]++;
+      }
+   }
+
+   void clear()
+   {
+      for (auto &s : samples)
+         s.clear();
+      std::fill(std::begin(n), std::end(n), 0);
+      std::fill(std::begin(sum_ns), std::end(sum_ns), 0.0);
+      std::fill(std::begin(max_ns), std::end(max_ns), 0);
+      std::memset(hist, 0, sizeof hist);
+   }
+
+   /* nearest-rank percentile of the kept samples, in ms */
+   static double pct(std::vector<int64_t> &v, double p)
+   {
+      if (v.empty())
+         return 0.0;
+      size_t k = static_cast<size_t>(std::ceil(p / 100.0 * static_cast<double>(v.size())));
+      k = k == 0 ? 0 : k - 1;
+      if (k >= v.size())
+         k = v.size() - 1;
+      std::nth_element(v.begin(), v.begin() + static_cast<long>(k), v.end());
+      return static_cast<double>(v[k]) / 1e6;
+   }
+
+   /* share of intervals within +-1.5 ms of k x period (k = 1..4), the rest "off" */
+   static std::string vsync_split(const std::vector<int64_t> &v, double period_ms)
+   {
+      uint32_t k_cnt[5] = {};
+      uint32_t off = 0;
+      for (int64_t ns : v)
+      {
+         double ms = static_cast<double>(ns) / 1e6;
+         double k = std::round(ms / period_ms);
+         if (k >= 1 && k <= 4 && std::fabs(ms - k * period_ms) <= 1.5)
+            k_cnt[static_cast<int>(k)]++;
+         else
+            off++;
+      }
+      char buf[160];
+      double tot = v.empty() ? 1.0 : static_cast<double>(v.size());
+      snprintf(buf, sizeof buf, " | vsync %.2fms 1x %.0f%% 2x %.0f%% 3x %.0f%% 4x %.0f%% off %.0f%%", period_ms,
+               100.0 * k_cnt[1] / tot, 100.0 * k_cnt[2] / tot, 100.0 * k_cnt[3] / tot, 100.0 * k_cnt[4] / tot,
+               100.0 * off / tot);
+      return buf;
+   }
+
+   /* The whole window as text; `stamp` = "HH:MM:SS". Leaves the samples reordered (not cleared). */
+   std::string format(const char *stamp, double window_s, double period_ms)
+   {
+      std::string out;
+      char buf[512];
+      double fps = window_s > 0 ? static_cast<double>(n[M_PRESENT_INTERVAL]) / window_s : 0.0;
+      snprintf(buf, sizeof buf, "=== %s %.1f s: presents %llu (%.1f fps)\n", stamp, window_s,
+               static_cast<unsigned long long>(n[M_PRESENT_INTERVAL]), fps);
+      out += buf;
+      for (int m = 0; m < M_COUNT; m++)
+      {
+         if (!n[m])
+            continue;
+         double mean = sum_ns[m] / static_cast<double>(n[m]) / 1e6;
+         snprintf(buf, sizeof buf, "%-17s n %5llu mean %7.2f p50 %7.2f p90 %7.2f p99 %7.2f max %7.2f", metric_name[m],
+                  static_cast<unsigned long long>(n[m]), mean, pct(samples[m], 50), pct(samples[m], 90),
+                  pct(samples[m], 99), static_cast<double>(max_ns[m]) / 1e6);
+         out += buf;
+         if (m == M_PRESENT_INTERVAL || m == M_COMMIT_INTERVAL)
+         {
+            out += vsync_split(samples[m], period_ms);
+            out += " | hist_ms";
+            const uint32_t *h = hist[m == M_COMMIT_INTERVAL];
+            for (int b = 0; b < HIST_BINS; b++)
+            {
+               if (!h[b])
+                  continue;
+               if (b == HIST_BINS - 1)
+                  snprintf(buf, sizeof buf, " >=%d:%u", b, h[b]);
+               else
+                  snprintf(buf, sizeof buf, " %d:%u", b, h[b]);
+               out += buf;
+            }
+         }
+         out += "\n";
+      }
+      return out;
+   }
+};
+
+inline int64_t now_ns()
+{
+   return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+inline bool enabled()
+{
+   static const bool on = [] {
+      const char *e = getenv("MALI_WSI_PACE");
+      return e && e[0] && e[0] != '0';
+   }();
+   return on;
+}
+
+struct pace_state
+{
+   std::mutex m;
+   pace_window w;
+   int64_t window_start = 0;
+   int64_t last_present = 0;
+   int64_t last_commit = 0;
+   double period_ms = 1000.0 / 90.0;
+   std::string path = "/root/mali-wsi-pace.txt";
+   pace_state()
+   {
+      const char *hz = getenv("MALI_WSI_PACE_HZ");
+      if (hz && atof(hz) > 1.0)
+         period_ms = 1000.0 / atof(hz);
+      const char *p = getenv("MALI_WSI_PACE_FILE");
+      if (p && p[0])
+         path = p;
+   }
+};
+
+inline pace_state &state()
+{
+   static pace_state *s = new pace_state(); /* never destroyed: the page-flip thread may outlive static teardown */
+   return *s;
+}
+
+/* Writes the window if 5 s are over; called with s.m held. */
+inline void maybe_flush_locked(pace_state &s, int64_t now)
+{
+   if (s.window_start == 0)
+   {
+      s.window_start = now;
+      return;
+   }
+   if (now - s.window_start < 5000000000LL)
+      return;
+   time_t t = time(nullptr);
+   struct tm tm;
+   localtime_r(&t, &tm);
+   char stamp[16];
+   snprintf(stamp, sizeof stamp, "%02d:%02d:%02d", tm.tm_hour, tm.tm_min, tm.tm_sec);
+   std::string text = s.w.format(stamp, static_cast<double>(now - s.window_start) / 1e9, s.period_ms);
+   s.w.clear();
+   s.window_start = now;
+   FILE *f = fopen(s.path.c_str(), "a");
+   if (f)
+   {
+      fputs(text.c_str(), f);
+      fclose(f);
+   }
+}
+
+inline void add(metric m, int64_t ns)
+{
+   if (!enabled())
+      return;
+   pace_state &s = state();
+   std::lock_guard<std::mutex> lock(s.m);
+   s.w.add(m, ns);
+}
+
+/* app thread, at vkQueuePresentKHR entry */
+inline void on_present(int64_t now, uint32_t pending_depth)
+{
+   pace_state &s = state();
+   std::lock_guard<std::mutex> lock(s.m);
+   if (s.last_present)
+      s.w.add(M_PRESENT_INTERVAL, now - s.last_present);
+   s.last_present = now;
+   s.w.add(M_PENDING_DEPTH, static_cast<int64_t>(pending_depth) * 1000000);
+   maybe_flush_locked(s, now);
+}
+
+/* page-flip thread (or app thread without it), right after wl_surface_commit */
+inline void on_commit(int64_t now)
+{
+   pace_state &s = state();
+   std::lock_guard<std::mutex> lock(s.m);
+   if (s.last_commit)
+      s.w.add(M_COMMIT_INTERVAL, now - s.last_commit);
+   s.last_commit = now;
+}
+
+} /* namespace mali_pace */
+} /* namespace wsi */
