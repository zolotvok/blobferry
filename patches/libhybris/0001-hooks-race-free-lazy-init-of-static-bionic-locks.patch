+/*
+ * Race-free lazy initialisation of statically initialised bionic objects.
+ * [Blobferry keeper, Claude Opus 5.5, 2026-11-01]
+ *
+ * A bionic mutex/cond/rwlock that was set up with a static initialiser (libc++'s constexpr std::mutex and
+ * std::condition_variable, PTHREAD_MUTEX_INITIALIZER, ...) holds a small value (<= ANDROID_TOP_ADDR_VALUE_*) in its
+ * first word until the first hooked call replaces it with a pointer to a glibc object. That replacement used to be
+ * "check, malloc + init, plain store": two threads that first-touch the same object each made their own glibc object,
+ * each locked its own one, and mutual exclusion was silently lost (one corrupted critical section per race).
+ *
+ * Now the first word is read with acquire semantics and published once:
+ *  - 8-byte aligned word: allocate, then compare-and-swap the pointer in; the loser destroys its object and uses the
+ *    winner's.
+ *  - word only 4-byte aligned (bionic's pthread types are int32 arrays, so this is legal): a 64-bit CAS could fault or
+ *    tear, so the publish runs under a striped glibc lock, writing the high half first and the low half with release;
+ *    readers acquire the low half first and fall back to the stripe lock while it still looks uninitialised.
+ * Lost races are counted and reported on stderr ("hybris-lazyinit:"), and the first lazy init of a process prints a
+ * one-line marker so a run can prove this code was loaded.
+ */
+static const char hybris_lazy_init_marker[] __attribute__((used)) = "blobferry-hybris-lazyinit-cas-1";
+
+#define HYBRIS_LAZY_STRIPES 64
+static pthread_mutex_t hybris_lazy_stripe[HYBRIS_LAZY_STRIPES] = {
+    [0 ... HYBRIS_LAZY_STRIPES - 1] = PTHREAD_MUTEX_INITIALIZER
+};
+static unsigned long hybris_lazy_lost;
+static int hybris_lazy_announced;
+
+static pthread_mutex_t *hybris_lazy_stripe_for(const void *obj)
+{
+    uintptr_t a = (uintptr_t) obj;
+    return &hybris_lazy_stripe[((a >> 3) ^ (a >> 11)) % HYBRIS_LAZY_STRIPES];
+}
+
+static int hybris_lazy_word_aligned(const void *obj)
+{
+    return ((uintptr_t) obj & (sizeof(uintptr_t) - 1)) == 0;
+}
+
+static void hybris_lazy_note(const char *kind, const void *obj, int lost)
+{
+    char line[160];
+    int n = -1;
+
+    if (!__atomic_exchange_n(&hybris_lazy_announced, 1, __ATOMIC_RELAXED))
+        n = snprintf(line, sizeof(line), "hybris-lazyinit: %s active (pid %d)\n",
+                     hybris_lazy_init_marker, (int) getpid());
+    if (n > 0)
+        (void) !write(2, line, (size_t) n);
+    if (!lost)
+        return;
+    unsigned long count = __atomic_add_fetch(&hybris_lazy_lost, 1, __ATOMIC_RELAXED);
+    /* first 16 races in full, then every power of two */
+    if (count > 16 && (count & (count - 1)) != 0)
+        return;
+    n = snprintf(line, sizeof(line), "hybris-lazyinit: race #%lu on %s %p (tid %ld, %s), resolved to one object\n",
+                 count, kind, obj, (long) syscall(SYS_gettid),
+                 hybris_lazy_word_aligned(obj) ? "cas" : "stripe");
+    if (n > 0)
+        (void) !write(2, line, (size_t) n);
+}
+
+/* First word of a bionic object, ordered before any use of the glibc object it points to. */
+static uintptr_t hybris_lazy_load(const void *obj)
+{
+#if UINTPTR_MAX > 0xFFFFFFFFu
+    if (!hybris_lazy_word_aligned(obj)) {
+        const uint32_t *half = (const uint32_t *) obj;   /* little endian: half[0] = low */
+        uint32_t lo = __atomic_load_n(&half[0], __ATOMIC_ACQUIRE);
+        if (lo > ANDROID_TOP_ADDR_VALUE_MUTEX)
+            return ((uintptr_t) __atomic_load_n(&half[1], __ATOMIC_RELAXED) << 32) | lo;
+        /* still looks uninitialised (or a published pointer with a tiny low half): read it whole, under the stripe */
+        pthread_mutex_t *stripe = hybris_lazy_stripe_for(obj);
+        pthread_mutex_lock(stripe);
+        uintptr_t value;
+        memcpy(&value, obj, sizeof(value));
+        pthread_mutex_unlock(stripe);
+        return value;
+    }
+#endif
+    return __atomic_load_n((const uintptr_t *) obj, __ATOMIC_ACQUIRE);
+}
+
+typedef void *(*hybris_lazy_alloc_t)(uintptr_t android_value);
+typedef void (*hybris_lazy_free_t)(void *real);
+
+/* obj's first word was seen as `seen` (<= top). Returns the one value published for obj (ours or the winner's). */
+static uintptr_t hybris_lazy_publish(void *obj, uintptr_t seen, uintptr_t top, const char *kind,
+                                     hybris_lazy_alloc_t alloc, hybris_lazy_free_t drop)
+{
+#if UINTPTR_MAX > 0xFFFFFFFFu
+    if (!hybris_lazy_word_aligned(obj)) {
+        pthread_mutex_t *stripe = hybris_lazy_stripe_for(obj);
+        uintptr_t value;
+        int lost = 1;
+        pthread_mutex_lock(stripe);
+        memcpy(&value, obj, sizeof(value));
+        if (value <= top) {
+            uintptr_t mine = (uintptr_t) alloc(value);
+            uint32_t *half = (uint32_t *) obj;
+            __atomic_store_n(&half[1], (uint32_t) (mine >> 32), __ATOMIC_RELAXED);
+            __atomic_store_n(&half[0], (uint32_t) mine, __ATOMIC_RELEASE);
+            value = mine;
+            lost = 0;
+        }
+        pthread_mutex_unlock(stripe);
+        hybris_lazy_note(kind, obj, lost);
+        return value;
+    }
+#endif
+    for (;;) {
+        void *mine = alloc(seen);
+        uintptr_t expected = seen;
+        if (__atomic_compare_exchange_n((uintptr_t *) obj, &expected, (uintptr_t) mine, 0,
+                                        __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+            hybris_lazy_note(kind, obj, 0);
+            return (uintptr_t) mine;
+        }
+        drop(mine);
+        if (expected > top) {
+            hybris_lazy_note(kind, obj, 1);
+            return expected;
+        }
+        seen = expected;   /* another small value (re-initialised object): try again with it */
+    }
+}
+
+static void *hybris_lazy_alloc_mutex(uintptr_t v) { return hybris_alloc_init_mutex((unsigned int) v); }
+static void *hybris_lazy_alloc_cond(uintptr_t v) { (void) v; return hybris_alloc_init_cond(); }
+static void *hybris_lazy_alloc_rwlock(uintptr_t v) { (void) v; return hybris_alloc_init_rwlock(); }
+static void hybris_lazy_free_mutex(void *p) { pthread_mutex_destroy(p); free(p); }
+static void hybris_lazy_free_cond(void *p) { pthread_cond_destroy(p); free(p); }
+static void hybris_lazy_free_rwlock(void *p) { pthread_rwlock_destroy(p); free(p); }
+
+/* value = hybris_lazy_load(obj), already checked against the "shared with Android" cases by the caller.
+ * One resolve path for every reader: small value -> publish once; shm handle -> shm pointer; else the glibc object. */
+static pthread_mutex_t *hybris_resolve_mutex(pthread_mutex_t *obj, uintptr_t value)
+{
+    if (value <= ANDROID_TOP_ADDR_VALUE_MUTEX)
+        value = hybris_lazy_publish(obj, value, ANDROID_TOP_ADDR_VALUE_MUTEX, "mutex",
+                                    hybris_lazy_alloc_mutex, hybris_lazy_free_mutex);
+    if (hybris_is_pointer_in_shm((void *) value))
+        return (pthread_mutex_t *) hybris_get_shmpointer((hybris_shm_pointer_t) value);
+    return (pthread_mutex_t *) value;
+}
+
+static pthread_cond_t *hybris_resolve_cond(pthread_cond_t *obj, uintptr_t value)
+{
+    if (value <= ANDROID_TOP_ADDR_VALUE_COND)
+        value = hybris_lazy_publish(obj, value, ANDROID_TOP_ADDR_VALUE_COND, "cond",
+                                    hybris_lazy_alloc_cond, hybris_lazy_free_cond);
+    if (hybris_is_pointer_in_shm((void *) value))
+        return (pthread_cond_t *) hybris_get_shmpointer((hybris_shm_pointer_t) value);
+    return (pthread_cond_t *) value;
+}
+
+static pthread_rwlock_t *hybris_resolve_rwlock(pthread_rwlock_t *obj, uintptr_t value)
+{
+    if (value <= ANDROID_TOP_ADDR_VALUE_RWLOCK)
+        value = hybris_lazy_publish(obj, value, ANDROID_TOP_ADDR_VALUE_RWLOCK, "rwlock",
+                                    hybris_lazy_alloc_rwlock, hybris_lazy_free_rwlock);
+    if (hybris_is_pointer_in_shm((void *) value))
+        return (pthread_rwlock_t *) hybris_get_shmpointer((hybris_shm_pointer_t) value);
+    return (pthread_rwlock_t *) value;
+}
