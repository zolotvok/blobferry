#version 450
// export-probe: write red into the exported image through a storage view, as gamescope's composite does
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform writeonly image2D dst;
void main() { imageStore(dst, ivec2(gl_GlobalInvocationID.xy), vec4(0, 0, 1, 1)); }
