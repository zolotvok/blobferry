#version 460
// SPDX-License-Identifier: GPL-3.0-or-later
// SPDX-License-Identifier: GPL-3.0-or-later
// rq-smoke compute shader: inline ray queries (VK_KHR_ray_query) against a one-triangle TLAS. [keeper, Claude Opus 5.5]
// mode 0: 16 fixed rays (4x4 grid), one vec4 + uvec4 result each. mode 1: grid x grid rays, hit count only (perf).
#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) buffer Out { uint hits; uint pad[3]; vec4 f[16]; uvec4 u[16]; } o;
layout(push_constant) uniform PC { uint mode; uint grid; } pc;

const float XS[4] = float[4](-0.8, -0.2, 0.2, 0.8);
const float YS[4] = float[4](-0.7, -0.1, 0.5, 0.9);

void main() {
    uint i = gl_GlobalInvocationID.x;
    vec3 org;
    if (pc.mode == 0u) {
        if (i >= 16u) return;
        org = vec3(XS[i % 4u], YS[i / 4u], 0.0);
    } else {
        if (i >= pc.grid * pc.grid) return;
        float g = float(pc.grid);
        org = vec3((float(i % pc.grid) + 0.5) / g * 2.0 - 1.0, (float(i / pc.grid) + 0.5) / g * 2.0 - 1.0, 0.0);
    }
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, org, 0.0, vec3(0.0, 0.0, 1.0), 100.0);
    while (rayQueryProceedEXT(q)) {}
    bool hit = rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
    if (pc.mode == 0u) {
        vec2 b = hit ? rayQueryGetIntersectionBarycentricsEXT(q, true) : vec2(-1.0);
        float t = hit ? rayQueryGetIntersectionTEXT(q, true) : -1.0;
        o.f[i] = vec4(hit ? 1.0 : 0.0, t, b.x, b.y);
        o.u[i] = hit ? uvec4(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true),
                             uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)),
                             uint(rayQueryGetIntersectionInstanceIdEXT(q, true)), 0xC0DEu)
                     : uvec4(0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xC0DEu);
    }
    if (hit) atomicAdd(o.hits, 1u);
}
