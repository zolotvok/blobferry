#version 460
// SPDX-License-Identifier: GPL-3.0-or-later
// as-probe compute shader: inline ray queries (VK_KHR_ray_query), every ray goes along +z from z = 0.
// mode 0: n rays from the Rays buffer (xyz origin, w tmax); res[i] = (0xC0DE0000 | geometry index << 8 | hit, t bits, custom
// index, primitive). Geometry index (bits 8..15) added 2026-11-10 for the multigeom/vfmt arms; bits 16..31 and bit 0 unchanged.
// mode 1 (race): n x n grid over area.xy..area.zw, reps traces each (jittered); counts traces whose t matches expt.x (old
// geometry), expt.y (new geometry), misses, other t into cnt[0..3]. [keeper, Claude Opus 5.5] 2026-11-10
#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) readonly buffer Rays { vec4 r[]; } rays;
layout(set = 0, binding = 2, std430) buffer Out { uint cnt[4]; uvec4 res[]; } o;
layout(push_constant) uniform PC { uint mode; uint n; uint reps; uint pad; vec4 area; vec2 expt; float tol; } pc;
shared uint sc[4];

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (pc.mode == 0u) {
        if (i >= pc.n) return;
        vec4 r = rays.r[i];
        rayQueryEXT q;
        rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, r.xyz, 0.0, vec3(0.0, 0.0, 1.0), r.w);
        while (rayQueryProceedEXT(q)) {}
        bool hit = rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
        o.res[i] = hit ? uvec4(0xC0DE0001u | ((uint(rayQueryGetIntersectionGeometryIndexEXT(q, true)) & 0xFFu) << 8), floatBitsToUint(rayQueryGetIntersectionTEXT(q, true)),
                               uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)),
                               uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)))
                       : uvec4(0xC0DE0000u, 0u, 0xFFFFFFFFu, 0xFFFFFFFFu);
        return;
    }
    if (gl_LocalInvocationIndex < 4u) sc[gl_LocalInvocationIndex] = 0u;
    barrier();
    uint a = 0u, b = 0u, m = 0u, x = 0u;
    if (i < pc.n * pc.n) {
        float g = float(pc.n);
        vec2 base = vec2((float(i % pc.n) + 0.5) / g, (float(i / pc.n) + 0.5) / g);
        for (uint k = 0u; k < pc.reps; k++) {
            vec2 uv = fract(base + vec2(float(k) * 0.618034, float(k) * 0.381966) / g);
            rayQueryEXT q;
            rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, vec3(mix(pc.area.xy, pc.area.zw, uv), 0.0), 0.0,
                                  vec3(0.0, 0.0, 1.0), 100.0);
            while (rayQueryProceedEXT(q)) {}
            if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) { m++; continue; }
            float t = rayQueryGetIntersectionTEXT(q, true);
            if (abs(t - pc.expt.x) < pc.tol) a++;
            else if (abs(t - pc.expt.y) < pc.tol) b++;
            else x++;
        }
    }
    if (a != 0u) atomicAdd(sc[0], a);
    if (b != 0u) atomicAdd(sc[1], b);
    if (m != 0u) atomicAdd(sc[2], m);
    if (x != 0u) atomicAdd(sc[3], x);
    barrier();
    if (gl_LocalInvocationIndex < 4u && sc[gl_LocalInvocationIndex] != 0u)
        atomicAdd(o.cnt[gl_LocalInvocationIndex], sc[gl_LocalInvocationIndex]);
}
